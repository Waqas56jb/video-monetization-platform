# =========================================================================
# MTONYO+ server environment
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# =========================================================================

NODE_ENV=production
PORT=4000

# Comma-separated origins allowed to call this API
CORS_ORIGINS=https://video-monetization-platform-chi.vercel.app,https://video-monetization-platform-admin.vercel.app

# Public URL of the viewer app — used to build shareable deep links
PUBLIC_WEB_URL=https://video-monetization-platform-chi.vercel.app
# Public URL of this API — used in og:image card URLs (never req.host)
SERVER_PUBLIC_URL=https://video-monetization-platform-server.vercel.app
ADMIN_WEB_URL=https://video-monetization-platform-admin.vercel.app

# ---------------------------------------------------------------- Supabase
# Project settings -> API
SUPABASE_URL=https://azkytxxvmcvsqmnbtfkh.supabase.co
SUPABASE_ANON_KEY=sb_publishable_qfk9Cds8AtnPDL5Z98yXNw_XuQrO3bA
# Project settings -> API -> JWT Secret (Reveal). HS256 local token verify.
# ES256 user access tokens still verify via JWKS without this.
SUPABASE_JWT_SECRET=
# Project settings -> API -> service_role (SECRET, server only, never ship to the browser)
# Without it the share-cards Storage bucket is never written, so /og/card/<slug>.jpg
# falls back to the API on every fetch. Nothing errors; WhatsApp posters just get slow
# enough to be dropped. It also disables admin user create/delete.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Database
# Project settings -> Database -> Connection string -> Transaction pooler.
# If you do not have the password, reset it there: "Reset database password".
# The pooler (port 6543) is the right choice for a serverless/long-lived API.
DATABASE_URL=postgresql://postgres.azkytxxvmcvsqmnbtfkh:YOUR_DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------- Cloudflare
# Dashboard -> Stream. Token needs Account -> Stream -> Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: set once you create a signing key (the server can create one for you)
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=
# Cloudflare calls this back when a video finishes processing
CLOUDFLARE_WEBHOOK_SECRET=

# --------------------------------------------------------------- Payments
# V1 runs a sandbox provider. Milestone 3 swaps this to "airpay" without
# touching the monetisation code.
PAYMENT_PROVIDER=sandbox
# How long the sandbox waits before "the customer approves on their phone" (ms)
SANDBOX_CONFIRM_DELAY_MS=4000
# Shared secret the provider signs its webhook with
PAYMENT_WEBHOOK_SECRET=change-me-in-production

# AirPay Tanzania (Milestone 3)
AIRPAY_BASE_URL=
AIRPAY_MERCHANT_ID=
AIRPAY_API_KEY=
AIRPAY_API_SECRET=

# ----------------------------------------------------------------- Jobs
# Secret required to trigger cron endpoints over HTTP
# Without it /api/jobs/premiere-expiry answers 403 to Vercel Cron every night, so a
# Paid Premiere never converts to Free + Ads. The failure is silent, so a missing
# value here looks exactly like the feature being switched off.
CRON_SECRET=change-me-in-production

# --- Outbound email (nodemailer) -------------------------------------------
# Reset links, sub-admin invites and announcements are sent by the platform
# itself. Gmail requires an *app password*, not the account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=MTONYO+ <your-address@gmail.com>

# How long an emailed link stays usable
RESET_TOKEN_MINUTES=60
INVITE_TOKEN_HOURS=72
